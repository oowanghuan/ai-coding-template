(version 1)
(deny default)
(allow process*)
(deny process-info* (target others))
(allow file-read-metadata)
(allow file-map-executable)
(allow mach-lookup (global-name "com.apple.system.logger"))
(allow file-read* (literal "/") (literal "/dev/null") (literal "/dev/urandom") (subpath "/System") (subpath "/usr") (subpath "/bin") (subpath "/sbin") (subpath "/Library/Developer") (subpath "/Library/Apple") (subpath "/private/var/db/dyld") (subpath "/private/preboot/Cryptexes") (subpath "/public/fixture/repository") (subpath "/public/fixture/dependencies") (subpath "/public/fixture/quality-run/T") (subpath "/public/fixture/quality-run/gate-C"))
(allow file-write* (literal "/dev/null") (subpath "/public/fixture/quality-run/gate-C"))
(deny file-write-unlink (literal "/public/fixture/quality-run/gate-C"))
(deny mach-lookup (global-name "com.apple.securityd") (global-name "com.apple.security.agent"))
(allow signal (target children))
