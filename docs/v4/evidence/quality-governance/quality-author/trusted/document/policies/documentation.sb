(version 1)
(deny default)
(allow process-exec)
(deny process-fork)
(deny process-info* (target others))
(allow file-read-metadata)
(allow file-map-executable)
(allow mach-lookup (global-name "com.apple.system.logger"))
(allow file-read* (literal "/") (literal "/dev/null") (literal "/dev/urandom") (subpath "/System") (subpath "/usr") (subpath "/bin") (subpath "/Library/Developer") (subpath "/Library/Apple") (subpath "/private/preboot/Cryptexes") (subpath "/private/var/db/dyld") (subpath "/public/fixture/quality-run/T/document/subject") (subpath "/public/fixture/quality-run/C/document/documentation"))
(allow file-write* (literal "/dev/null") (require-all (subpath "/public/fixture/quality-run/C/document") (subpath "/public/fixture/quality-run/C/document/documentation")))
(deny file-write-unlink (literal "/public/fixture/quality-run/C/document") (literal "/public/fixture/quality-run/C/document/documentation"))
