(version 1)
(deny default)
(allow process-exec)
(deny process-fork)
(deny process-info* (target others))
(allow file-read-metadata)
(allow file-map-executable)
(allow mach-lookup (global-name "com.apple.system.logger"))
(allow file-read* (literal "/") (literal "/dev/null") (literal "/dev/urandom") (subpath "/System") (subpath "/usr") (subpath "/bin") (subpath "/Library/Developer") (subpath "/Library/Apple") (subpath "/private/preboot/Cryptexes") (subpath "/private/var/db/dyld") (subpath "<EXPERIMENT>/T/q-mechanical/subject") (subpath "<EXPERIMENT>/C/q-mechanical/new"))
(allow file-write* (literal "/dev/null") (require-all (subpath "<EXPERIMENT>/C/q-mechanical") (subpath "<EXPERIMENT>/C/q-mechanical/new")))
(deny file-write-unlink (literal "<EXPERIMENT>/C/q-mechanical") (literal "<EXPERIMENT>/C/q-mechanical/new"))
