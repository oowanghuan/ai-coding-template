(version 1)
(deny default)
(allow process*)
(deny process-info* (target others))
(allow file-read-metadata)
(allow file-map-executable)
(allow mach-lookup (global-name "com.apple.system.logger"))
(allow file-read* (literal "/") (literal "/dev/null") (literal "/dev/urandom") (subpath "/System") (subpath "/usr") (subpath "/bin") (subpath "/sbin") (subpath "/Library/Developer") (subpath "/Library/Apple") (subpath "/private/var/db/dyld") (subpath "/private/preboot/Cryptexes") (subpath "<checkout>") (subpath "<owner-home>/Library/Python/3.9/lib/python/site-packages") (subpath "<runs>/v4-timing-independent-sjuali1q/T") (subpath "<runs>/v4-timing-independent-sjuali1q/C"))
(allow file-write* (literal "/dev/null") (subpath "<runs>/v4-timing-independent-sjuali1q/C"))
(deny file-write-unlink (literal "<runs>/v4-timing-independent-sjuali1q/C"))
(deny mach-lookup (global-name "com.apple.securityd") (global-name "com.apple.security.agent"))
(allow signal (target children))
