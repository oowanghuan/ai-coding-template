(version 1)
(deny default)
(allow process*)
(deny process-info* (target others))
(allow file-read-metadata)
(allow mach-lookup (global-name "com.apple.system.logger"))
(deny mach-lookup (global-name "com.apple.securityd") (global-name "com.apple.security.agent"))
(allow file-read* (subpath "/System") (subpath "/usr") (subpath "/Library/Developer") (subpath "/Library/Apple") (subpath "/private/var/db/dyld") (subpath "/bin") (subpath "/sbin") (subpath "/private/preboot/Cryptexes") (subpath "<INITIAL_EXPERIMENT>/T") (subpath "<INITIAL_EXPERIMENT>/C") (literal "/dev/null") (literal "/dev/urandom") (literal "/"))
(allow file-map-executable)
(allow file-write* (subpath "<INITIAL_EXPERIMENT>/C") (literal "/dev/null"))
(deny file-write-unlink (literal "<INITIAL_EXPERIMENT>/C"))
(allow signal (target children))
