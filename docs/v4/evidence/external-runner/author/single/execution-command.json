{
  "candidate": [
    "/usr/bin/sandbox-exec",
    "-f",
    "<EXPERIMENT_SINGLE>/trusted/outer.sb",
    "/usr/bin/python3",
    "-B",
    "-S",
    "<EXPERIMENT_SINGLE>/trusted/candidate_harness.py",
    "execute",
    "--experiment",
    "<EXPERIMENT_SINGLE>",
    "--repo",
    "<WORKSPACE>",
    "--scenario",
    "single"
  ],
  "candidate_environment": {
    "HOME": "<EXPERIMENT_SINGLE>/candidate",
    "TMPDIR": "<EXPERIMENT_SINGLE>/candidate",
    "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
    "PYTHONPATH": "<WORKSPACE>:<DEPENDENCIES>",
    "PYTHONNOUSERSITE": "1",
    "PYTHONDONTWRITEBYTECODE": "1",
    "V4_OUTER_SEATBELT": "1"
  },
  "driver": [
    "/usr/bin/python3",
    "-I",
    "-B",
    "-S",
    "<EXPERIMENT_SINGLE>/trusted/launch_driver.py",
    "--config",
    "<EXPERIMENT_SINGLE>/trusted/config.json"
  ],
  "driver_environment": {
    "HOME": "<EXPERIMENT_SINGLE>/trusted/home",
    "TMPDIR": "<EXPERIMENT_SINGLE>/trusted/tmp",
    "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
    "PYTHONNOUSERSITE": "1",
    "PYTHONDONTWRITEBYTECODE": "1"
  }
}
